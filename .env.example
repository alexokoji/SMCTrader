# --- Server ---
NODE_ENV=development
PORT=4000
# URL of the web app (used for CORS)
WEB_ORIGIN=http://localhost:3000

# --- Security ---
# Secret used to sign session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
# Envelope key used to encrypt exchange API secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=change-me-in-production

# --- Database ---
# MongoDB connection string. Keep the real URI only in .env or your host's
# secret manager; never commit it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=smctrader

# --- Market data ---
# Public REST market data is used when no private keys are present.
BINANCE_REST=https://api.binance.com
BYBIT_REST=https://api.bybit.com
# Ordered public data sources. The feed automatically uses the next source
# whenever one exchange is unavailable. Values: binance,bybit,bitget,okx,kucoin
MARKET_DATA_EXCHANGES=binance,bybit,bitget,okx,kucoin
# `demo` supplies deterministic simulated candles for local UI/paper-trading
# development if your network cannot reach an exchange. Use `live` in
# production only when the configured public exchanges are reachable.
MARKET_DATA_MODE=demo
