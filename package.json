{
  "name": "smctrader",
  "version": "1.0.0",
  "private": true,
  "description": "Automated rules-based Smart Money Concept crypto trading platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @smc/core && npm run build -w @smc/api && npm run build -w @smc/web",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w @smc/core",
    "typecheck": "npm run typecheck --workspaces",
    "dev:api": "npm run dev -w @smc/api",
    "dev:web": "npm run dev -w @smc/web"
    ,"dev:worker": "npm run dev -w @smc/worker"
    ,"deploy:worker": "npm run deploy -w @smc/worker"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "lightweight-charts": "5.2.1",
    "vite": "^7.3.1"
  }
}
