{
  "name": "@smc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for the Smart Money Concept strategy engine",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
